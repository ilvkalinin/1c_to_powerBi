<?xml version="1.0" encoding="UTF-8"?>
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>NFG bounded refresh for mart.unconfirmed_service_debt_movement</Description>
  </RegistrationInfo>
  <Triggers />
  <Principals>
    <Principal id="Author">
      <UserId>__TASK_USER_SID__</UserId>
      <LogonType>Password</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <AllowHardTerminate>true</AllowHardTerminate>
    <ExecutionTimeLimit>PT5M</ExecutionTimeLimit>
    <Enabled>true</Enabled>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>powershell.exe</Command>
      <Arguments>-NoProfile -NonInteractive -ExecutionPolicy Bypass -File "__PROJECT_ROOT__\scripts\run_unconfirmed_service_debt_movement_incremental_scheduled.ps1" -ProjectRoot "__PROJECT_ROOT__" -PythonExe "__PYTHON_EXE__" -LogDirectory "__LOG_DIRECTORY__" -EnvFile "__ENV_FILE__"</Arguments>
      <WorkingDirectory>__PROJECT_ROOT__</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
