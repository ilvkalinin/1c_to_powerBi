# Every PostgreSQL runner loads the repository-root .env before opening a
# socket, or the absolute NFG_ENV_FILE path when it is set by the VM wrapper.
# These values take precedence over inherited shell variables.
# VM-1: raw 1C source. Use a read-only database role.
SOURCE_PGHOST=
SOURCE_PGPORT=
SOURCE_PGDATABASE=
SOURCE_PGUSER=
SOURCE_PGPASSWORD=
SOURCE_PGSSLMODE=

# VM-2: analytical mart database.
MART_PGHOST=
MART_PGPORT=
MART_PGDATABASE=
MART_PGUSER=
MART_PGPASSWORD=
MART_PGSSLMODE=
